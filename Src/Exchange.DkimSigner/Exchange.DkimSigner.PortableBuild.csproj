<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ExchangeDkimSigner</AssemblyName>
    <RootNamespace>Exchange.DkimSigner</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <PortableMimeKitVersion Condition="'$(PortableMimeKitVersion)' == ''">2.15.1</PortableMimeKitVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Exchange.Data.Common">
      <HintPath>lib/Exchange 15/Microsoft.Exchange.Data.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Exchange.Data.Transport">
      <HintPath>lib/Exchange 15/Microsoft.Exchange.Data.Transport.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- This compatibility-only patch must bind to the MimeKit 2.15 assembly already
         deployed by Exchange DKIM Signer 3.4.0. The advisory requires constructing
         untrusted SMTP envelope addresses and sending them through an SMTP client;
         this transport agent only parses and signs an existing MIME message. -->
    <PackageReference Include="MimeKit" Version="$(PortableMimeKitVersion)" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-g7hc-96xr-gvvx" Condition="'$(PortableMimeKitVersion)' == '2.15.1'" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
